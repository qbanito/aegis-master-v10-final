PORT=8804
# If omitted and MUAPI_API_KEY exists, Media Brain automatically uses muapi.
MEDIA_GENERATION_PROVIDER=
MUAPI_BASE_URL=https://api.muapi.ai
MUAPI_API_KEY=
MEDIA_GENERATION_TIMEOUT_MS=900000
MUAPI_TTS_MODEL=minimax-speech-2.6-turbo
MUAPI_TTS_VOICE_ID=female-calm
MUAPI_TTS_SPEED=1

# Product-aware content automation. Only Commerce and SaaS are eligible;
# Finance/trading bots are intentionally excluded from commercial content.
COMMERCE_BRAIN_URL=http://localhost:8802
SAAS_BRAIN_URL=http://localhost:8792
MEDIA_AUTOMATION_ENABLED=true
MEDIA_AUTOMATION_CRON=0 */6 * * *
MEDIA_AUTOMATION_MAX_ITEMS=12
# brief = copy/briefs only, mock = local generation jobs, remote = provider-backed assets.
MEDIA_AUTOMATION_ASSET_MODE=brief

# mock = PAPER jobs without external billing; muapi = real image/video/audio/lip-sync generation.
# Keep MUAPI_API_KEY server-side. Never place it in VITE_* variables or commit a .env file.
