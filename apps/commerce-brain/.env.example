# Commerce Brain defaults to PAPER and never publishes externally by default.
COMMERCE_MODE=PAPER
# remote is selected automatically when the shared MUAPI_API_KEY exists.
COMMERCE_ASSET_MODE=
COMMERCE_AUTOMATION_ENABLED=true
# PAPER intelligence cycle; landing/creative generation remains an explicit action.
COMMERCE_AUTOMATION_INTERVAL_MS=900000
# Explicit production gates. Keep false until the store and ad accounts are verified.
COMMERCE_LIVE_ADS_ENABLED=false
COMMERCE_LIVE_PUBLISH=false
COMMERCE_WEBHOOK_SECRET=
MEDIA_BRAIN_URL=http://localhost:8804

# AliExpress adapter: provide either a supported API key or a product-feed URL.
ALIEXPRESS_API_KEY=
ALIEXPRESS_API_URL=

# Amazon Product Advertising API (PA-API).
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PRODUCT_FEED_URL=

# Shopify Admin API. The implementation prepares drafts until publish is explicitly enabled.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2025-07
