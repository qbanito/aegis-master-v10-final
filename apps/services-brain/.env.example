PORT=8808
SERVICES_MODE=PAPER
COMMERCE_BRAIN_URL=http://localhost:8802
MEDIA_BRAIN_URL=http://localhost:8804
SAAS_BRAIN_URL=http://localhost:8790
APP_URL=http://localhost:8815
SERVICES_PUBLIC_URL=http://localhost:8815
SERVICES_API_TOKEN=
SERVICES_ALLOWED_ORIGINS=http://localhost:8815,http://localhost:8810
SERVICES_AUTOMATION_ENABLED=false
SERVICES_REQUIRE_APPROVAL=true
SERVICES_MAX_OUTREACH_PER_DAY=40
SERVICES_RATE_LIMIT_PER_MINUTE=120
SERVICES_UNSUBSCRIBE_SECRET=

# Resend: add only domains verified in your Resend account.
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_DOMAIN=boostifymusic.site
RESEND_FROM_EMAIL=hello@boostifymusic.site
RESEND_FROM_NAME=BoostifyDev Services
RESEND_REPLY_TO_EMAIL=hello@boostifymusic.site
# Format: email@domain|Display Name,email2@domain|Display Name
RESEND_OUTREACH_POOL=
RESEND_WEBHOOK_SECRET=

# Official publishing connectors. Leave empty until OAuth permissions are verified.
LINKEDIN_ACCESS_TOKEN=
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Payments. Checkout remains locked until this is configured and explicitly approved.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional real-media generation status used by the sales dashboard.
MUAPI_API_KEY=muapi_xxxxxxxxx
