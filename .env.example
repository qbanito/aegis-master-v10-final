NODE_ENV=development
AEGIS_SHARED_SECRET=change-me
AEGIS_AI_PROVIDER=mock
AEGIS_AI_TIMEOUT_MS=7000
AEGIS_BRAIN_CHAT_TIMEOUT_MS=6000

# Brain services
FINANCE_BRAIN_URL=http://localhost:8787
COMMERCE_BRAIN_URL=http://localhost:8802
SAAS_BRAIN_URL=http://localhost:8790
MEDIA_BRAIN_URL=http://localhost:8804
SERVICES_BRAIN_URL=http://localhost:8808
MANAGER_BRAIN_URL=http://localhost:8805
CEO_BRAIN_URL=http://localhost:8806

# Services Brain: use only verified Resend domains and keep real secrets out of git.
SERVICES_PUBLIC_URL=http://localhost:8815
SERVICES_API_TOKEN=
SERVICES_ALLOWED_ORIGINS=http://localhost:8815,http://localhost:8810
SERVICES_AUTOMATION_ENABLED=false
SERVICES_REQUIRE_APPROVAL=true
SERVICES_MAX_OUTREACH_PER_DAY=40
SERVICES_RATE_LIMIT_PER_MINUTE=120
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=BoostifyDev Services
RESEND_REPLY_TO_EMAIL=
RESEND_OUTREACH_POOL=
RESEND_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
LINKEDIN_ACCESS_TOKEN=
META_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Server-side providers only. Never commit real values.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
MUAPI_API_KEY=

# Media generation: mock is safe PAPER mode; change to muapi explicitly to enable remote generation.
MEDIA_GENERATION_PROVIDER=mock
MUAPI_BASE_URL=https://api.muapi.ai
MEDIA_GENERATION_TIMEOUT_MS=900000

# Finance Brain PAPER controls. These never enable live trading.
PAPER_MODEL_FALLBACK=true
PAPER_MODEL_MAX_TRADES_PER_HOUR=25
PAPER_EXECUTE_WATCH=true

# Master UI
VITE_CEO_BRAIN_URL=http://localhost:8806
VITE_MANAGER_BRAIN_URL=http://localhost:8805
VITE_FINANCE_BRAIN_URL=http://localhost:8787
VITE_COMMERCE_BRAIN_URL=http://localhost:8802
VITE_SAAS_BRAIN_URL=http://localhost:8790
VITE_MEDIA_BRAIN_URL=http://localhost:8804
VITE_SERVICES_BRAIN_URL=http://localhost:8808
